  def twoStacks(x, a, b):
    # Initialize two pointers for both stacks
    i, j = 0, 0
    current_sum = 0
    max_operations = 0

    # Iterate through the stacks while maintaining the sum less than or equal to x
    while i < len(a) and current_sum + a[i] <= x:
        current_sum += a[i]
        i += 1

    max_operations = i  # Store the maximum operations using only stack a

    # Now try to add elements from stack b and keep the sum <= x
    while j < len(b) and i >= 0:
        current_sum += b[j]
        j += 1
        
        # If the sum exceeds x, we pop from stack a to make the sum valid
        while current_sum > x and i > 0:
            i -= 1
            current_sum -= a[i]
        
        if current_sum <= x:
            max_operations = max(max_operations, i + j)

    return max_operations


# Example usage
if __name__ == "__main__":
    # Stack a and b, with total sum limit x
    x = 10
    a = [4, 2, 4, 6, 1]
    b = [2, 3, 5, 1]

    print(f"Maximum operations possible: {twoStacks(x, a, b)}")
