  # Class to implement Queue using Two Stacks
class QueueUsingTwoStacks:
    def __init__(self):
        # Initialize two stacks
        self.stack1 = []
        self.stack2 = []
    
    # Function to enqueue (add element to the queue)
    def enqueue(self, item):
        # Push the item to stack1
        self.stack1.append(item)
    
    # Function to dequeue (remove element from the queue)
    def dequeue(self):
        # If both stacks are empty, the queue is empty
        if not self.stack1 and not self.stack2:
            raise IndexError("dequeue from empty queue")
        
        # If stack2 is empty, move elements from stack1 to stack2
        if not self.stack2:
            while self.stack1:
                self.stack2.append(self.stack1.pop())
        
        # Pop the element from stack2
        return self.stack2.pop()

    # Function to get the front element of the queue without dequeuing
    def front(self):
        if not self.stack1 and not self.stack2:
            raise IndexError("front from empty queue")
        
        # If stack2 is empty, move elements from stack1 to stack2
        if not self.stack2:
            while self.stack1:
                self.stack2.append(self.stack1.pop())
        
        # Return the top element of stack2 (front of the queue)
        return self.stack2[-1]

    # Function to check if the queue is empty
    def is_empty(self):
        return not self.stack1 and not self.stack2

    # Function to get the size of the queue
    def size(self):
        return len(self.stack1) + len(self.stack2)


# Test the QueueUsingTwoStacks class
if __name__ == "__main__":
    queue = QueueUsingTwoStacks()

    # Enqueue elements
    queue.enqueue(1)
    queue.enqueue(2)
    queue.enqueue(3)
    print(f"Front element: {queue.front()}")  # Output: 1
    print(f"Size of queue: {queue.size()}")   # Output: 3

    # Dequeue elements
    print(f"Dequeued element: {queue.dequeue()}")  # Output: 1
    print(f"Dequeued element: {queue.dequeue()}")  # Output: 2

    # Enqueue more elements
    queue.enqueue(4)
    queue.enqueue(5)
    print(f"Front element: {queue.front()}")  # Output: 3
    print(f"Size of queue: {queue.size()}")   # Output: 3

    # Dequeue all remaining elements
    print(f"Dequeued element: {queue.dequeue()}")  # Output: 3
    print(f"Dequeued element: {queue.dequeue()}")  # Output: 4
    print(f"Dequeued element: {queue.dequeue()}")  # Output: 5

    # Check if the queue is empty
    print(f"Is queue empty? {queue.is_empty()}")  # Output: True
