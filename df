# Function to check if the brackets are balanced
def is_balanced(expression):
    # Create a stack to store opening brackets
    stack = []
    
    # Dictionary to match closing brackets with their respective opening brackets
    bracket_pairs = {
        ')': '(',
        '}': '{',
        ']': '['
    }
    
    # Loop through each character in the expression
    for char in expression:
        # If it's an opening bracket, push it onto the stack
        if char in bracket_pairs.values():

      
            stack.append(char)
        # If it's a closing bracket, check if it matches the top of the stack
        elif char in bracket_pairs.keys():
            # If stack is empty or top of stack is not the correct opening bracket
            if not stack or stack[-1] != bracket_pairs[char]:
                return False
            # Pop the top element as the pair is balanced
            stack.pop()
    
    # If the stack is empty, all brackets are balanced
    return len(stack) == 0


# Test cases
if __name__ == "__main__":
    test_cases = [
        "([]{})",  # Balanced
        "([)]",    # Not Balanced
        "{[()()]}",# Balanced
        "((()))",  # Balanced
        "[({})]",  # Balanced
        "{[(",     # Not Balanced
    ]
    
    for expression in test_cases:
        print(f"Expression: {expression} -> Balanced: {is_balanced(expression)}")

